#include "Base.xcconfig"
// A local server on this machine may be reached over plain HTTP while developing, and only here: the key is
// written into Info.plist by the preprocessor in this configuration alone.
PURLAY_PLIST_DEFINITIONS = PURLAY_ALLOWS_LOCAL_NETWORKING=1
SWIFT_OPTIMIZATION_LEVEL = -Onone
// One binary, one signature: the separate debug dylib (for previews, unused here) would be loaded under library validation
// and refused whenever its signature and the app's differ.
ENABLE_DEBUG_DYLIB = NO
