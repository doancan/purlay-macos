    "1. Open Invitations in your browser and create an invitation link.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Tarayıcıda Davetler’i aç ve bir davet bağlantısı oluştur."
          }
        }
      }
    },
    "2. Share the link with the person you want to invite.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Bağlantıyı davet etmek istediğin kişiyle paylaş."
          }
        }
      }
    },
    "3. They sign in and accept the invitation to join as a member.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Kişi giriş yapar ve daveti kabul ederek üye olarak katılır."
